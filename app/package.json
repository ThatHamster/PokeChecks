{
  "name": "pokechecks-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run wasm && vite",
    "typecheck": "npm run wasm && tsc -b",
    "build": "npm run wasm && tsc -b && vite build",
    "preview": "vite preview",
    "assets": "node scripts/generate-assets.mjs && capacitor-assets generate --android --ios --iconBackgroundColor \"#fff6e6\" --iconBackgroundColorDark \"#17122e\" --splashBackgroundColor \"#fff6e6\" --splashBackgroundColorDark \"#17122e\"",
    "cap:sync": "npm run build && cap sync",
    "capacitor:sync:after": "node scripts/fix-spm-paths.mjs",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "idb-keyval": "^6.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.9",
    "@fontsource/fredoka": "^5.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "opentype.js": "^1.3.4",
    "typescript": "5.8",
    "vite": "^6.4.4"
  }
}
